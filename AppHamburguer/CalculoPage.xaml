<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHamburguer.CalculoPage"
             Title="Etanol x Gasolina">
    <ScrollView>
    <VerticalStackLayout>
        <Label 
            Text="Preço Etanol (R$):"
            FontSize="16" />

            <Entry
                x:Name="precoEtanoltxt"
                Placeholder="Ex:3.89"
                Keyboard="Numeric"/>
        
        
            <Label
                Text="Preço Gasolina (R$):"
                />

            <Entry
                x:Name="precoGasolinatxt"
                Placeholder="Ex:5.99"
                Keyboard="Numeric"/>

            <Button
                Text="Calcular"
                Clicked="OnCalcularCliked"
                Margin="0,10,0,0"/>

            <Label x:Name="lblResultado"
                   FontSize="18"
                   FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>