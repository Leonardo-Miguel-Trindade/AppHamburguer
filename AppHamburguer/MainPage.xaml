<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHamburguer.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Utiliário de Carro"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,10" />

            <Image
                Source="dotnet_bot.png"
                HorizontalOptions="Center"
                HeightRequest="200"
                />

            <Label
                Text="Seja bem vindo"
                FontSize="18"
                HorizontalOptions="Center"/>

            <Label Text="Abra o menu lateral (gaveta) no canto superior para acessar os calculos"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="Gray"
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
    
    

</ContentPage>
